Algoritmo semaforo
	Definir unidades Como Entero
	Escribir "Escribir unidades"
	Leer unidades
	si unidades <= 0 Entonces
		Escribir "Error"
	SiNo
		si unidades =0 Entonces
			Escribir "Agotado broder"
		SiNo
			si unidades >= 1 y unidades <=10 Entonces
				Escribir "Pedir"
			SiNo
				Escribir "Todo bien"
			FinSi
		Finsi
		
		
		
	FinSi
		
	
FinAlgoritmo
